rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if true; }

    match /news/{newsId} {
      allow read: if true;
      allow write: if false; // Only written via backend
    }
    match /members/{memberId} {
      allow read: if true;
      allow write: if false; // Only written via backend
    }
    match /contacts/{contactId} {
      allow read: if true;
      allow write: if false; // Only written via backend
    }
  }
}
